generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DATA_ENTRY
  TEACHER
  VIEWER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  EARLY_LEFT
  PASSED_OUT
  TRANSFERRED
  GRADUATED
}

enum AdmissionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum InventoryTransactionType {
  STOCK_IN
  USAGE
  ADJUSTMENT
  DAMAGED
}

enum BoardApplicationStatus {
  APPLIED
  PASSED
  FAILED
}

enum BackupType {
  CSV
  DATABASE
}

enum DocumentType {
  STUDENT_PHOTO
  B_FORM
  CNIC
  BIRTH_CERTIFICATE
  PREVIOUS_CERTIFICATE
  OTHER
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  fullName     String
  passwordHash String
  role         UserRole @default(DATA_ENTRY)
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

model Department {
  id            String   @id @default(uuid())
  code          String   @unique
  nameEn        String
  nameUr        String
  descriptionEn String?
  descriptionUr String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classes            Class[]
  enrollments        StudentEnrollment[]
  admissions         StudentAdmission[]
  teacherDepartments TeacherDepartment[]
  attendanceSessions AttendanceSession[]
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes     Class[]
  enrollments StudentEnrollment[]
  admissions  StudentAdmission[]
}

model Student {
  id String @id @default(uuid())

  registrationNumber String? @unique

  fullNameEn   String?
  fullNameUr   String?
  fatherNameEn String?
  fatherNameUr String?

  dateOfBirth DateTime?
  gender      Gender?

  nationality String?
  religion    String?

  bFormNumber String? @unique
  cnicNumber  String? @unique

  phonePrimary   String?
  phoneSecondary String?
  phoneEmergency String?
  email          String?

  permanentAddress String?
  currentAddress   String?
  city             String?
  district         String?

  photoUrl String?
  status   StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians         Guardian[]
  enrollments       StudentEnrollment[]
  admissions        StudentAdmission[]
  documents         StudentDocument[]
  attendanceRecords AttendanceRecord[]
  statusHistory     StudentStatusHistory[]
  hifzReports       HifzDailyReport[]
  prizes            StudentPrize[]
  sponsorships      Sponsorship[]
  boardApplications BoardApplication[]
  visits            Visit[]

  @@index([fullNameEn])
  @@index([fullNameUr])
  @@index([fatherNameEn])
  @@index([fatherNameUr])
}

model Guardian {
  id        String @id @default(uuid())
  studentId String

  nameEn         String?
  nameUr         String?
  relationshipEn String?
  relationshipUr String?

  phonePrimary   String?
  phoneSecondary String?
  cnic           String?
  occupation     String?
  address        String?

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model StudentAdmission {
  id        String @id @default(uuid())
  studentId String

  admissionNumber    String @unique
  registrationNumber String?
  admissionDate      DateTime

  academicYearId String
  departmentId   String
  classId        String?

  previousInstitution      String?
  previousClass            String?
  previousEducationDetails String?

  status    AdmissionStatus @default(ACTIVE)
  remarks   String?
  startDate DateTime @default(now())
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  department Department @relation(fields: [departmentId], references: [id])

  class Class? @relation(fields: [classId], references: [id])

  @@index([studentId, status])
  @@index([departmentId, classId])
}

model StudentDocument {
  id        String       @id @default(uuid())
  studentId String
  type      DocumentType
  fileName  String
  fileUrl   String
  mimeType  String?
  fileSize  Int?
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type])
}

model Class {
  id             String @id @default(uuid())
  departmentId   String
  academicYearId String

  nameEn    String
  nameUr    String?
  code      String?
  capacity  Int?
  classType String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  enrollments        StudentEnrollment[]
  admissions         StudentAdmission[]
  attendanceSessions AttendanceSession[]
  timetableEntries   TimetableEntry[]

  @@unique([departmentId, academicYearId, nameEn])
}

model StudentEnrollment {
  id             String @id @default(uuid())
  studentId      String
  departmentId   String
  classId        String
  academicYearId String

  rollNumber     String?
  enrollmentDate DateTime @default(now())
  startDate      DateTime @default(now())
  endDate        DateTime?
  status         String   @default("ACTIVE")
  remarks        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  department Department @relation(fields: [departmentId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([studentId])
  @@index([departmentId, classId])
}

model StudentStatusHistory {
  id            String        @id @default(uuid())
  studentId     String
  status        StudentStatus
  effectiveDate DateTime      @default(now())
  reason        String?
  createdAt     DateTime      @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Teacher {
  id             String @id @default(uuid())
  employeeNumber String @unique
  firstName      String
  lastName       String?
  fatherName     String?
  cnic           String?
  phone          String?
  email          String?
  address        String?
  joiningDate    DateTime?
  status         String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments     TeacherDepartment[]
  timetableEntries TimetableEntry[]
  visits           Visit[]
}

model TeacherDepartment {
  id           String @id @default(uuid())
  teacherId    String
  departmentId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, departmentId])
}

model Timetable {
  id             String @id @default(uuid())
  name           String
  departmentId   String?
  academicYearId String?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TimetableEntry[]
}

model TimetableEntry {
  id          String @id @default(uuid())
  timetableId String
  teacherId   String
  classId     String
  dayOfWeek   Int
  startTime   String
  endTime     String
  subjectName String?
  room        String?
  remarks     String?

  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  teacher Teacher @relation(fields: [teacherId], references: [id])

  class Class @relation(fields: [classId], references: [id])
}

model AttendanceSession {
  id           String @id @default(uuid())
  departmentId String
  classId      String
  date         DateTime
  sessionType  String @default("DAILY")

  createdAt DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  records AttendanceRecord[]

  @@unique([classId, date, sessionType])
}

model AttendanceRecord {
  id                  String @id @default(uuid())
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus
  remarks             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id])

  @@unique([attendanceSessionId, studentId])
}

model HifzDailyReport {
  id                String @id @default(uuid())
  studentId         String
  date              DateTime
  sabaq             String?
  sabqi             String?
  manzil            String?
  performanceRating String?
  remarks           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
}

model Visit {
  id             String @id @default(uuid())
  studentId      String?
  teacherId      String?
  visitorName     String
  visitorRelation String?
  visitorCnic     String?
  visitorAddress  String?
  visitorPhone    String?
  visitDate      DateTime
  checkInTime    DateTime?
  checkOutTime   DateTime?
  reason         String?
  details        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student? @relation(fields: [studentId], references: [id])

  teacher Teacher? @relation(fields: [teacherId], references: [id])
}

model PrizeCategory {
  id            String @id @default(uuid())
  nameEn        String @unique
  nameUr        String?
  descriptionEn String?
  descriptionUr String?

  prizes StudentPrize[]
}

model StudentPrize {
  id                String @id @default(uuid())
  studentId         String
  categoryId        String
  awardDate         DateTime
  competitionName   String?
  prizeName         String?
  certificateNumber String?
  remarks           String?

  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  category PrizeCategory @relation(fields: [categoryId], references: [id])
}

model InventoryItem {
  id              String @id @default(uuid())
  nameEn          String @unique
  nameUr          String?
  unit            String
  minimumQuantity Float @default(0)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id              String @id @default(uuid())
  itemId          String
  type            InventoryTransactionType
  quantity        Float
  transactionDate DateTime @default(now())
  remarks         String?

  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Sponsor {
  id        String @id @default(uuid())
  name      String
  address   String?
  phone     String?
  reference String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sponsorships Sponsorship[]
}

model Sponsorship {
  id        String @id @default(uuid())
  sponsorId String
  studentId String
  amount    Decimal @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime?
  reference String?
  status    String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sponsor Sponsor @relation(fields: [sponsorId], references: [id])

  student Student @relation(fields: [studentId], references: [id])
}

model BoardApplication {
  id                String @id @default(uuid())
  studentId         String
  applicationNumber String @unique
  rollNumber        String?
  applicationDate   DateTime
  position          String?
  status            BoardApplicationStatus @default(APPLIED)

  sanadIssued       Boolean @default(false)
  sanadIssuedDate   DateTime?
  sanadCollected    Boolean @default(false)
  sanadCollectedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}

model AuditLog {
  id         String @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model SyncQueue {
  id         String @id @default(uuid())
  entityType String
  entityId   String
  operation  SyncOperation
  payload    Json?
  status     SyncStatus @default(PENDING)
  retryCount Int @default(0)
  lastError  String?

  createdAt DateTime @default(now())
  syncedAt   DateTime?

  @@index([status, createdAt])
}

model BackupLog {
  id       String @id @default(uuid())
  type     BackupType
  location String
  status   String
  error    String?

  createdAt DateTime @default(now())
}

// --- Finance module (cash, salaries, khata, supplies, inventory, sponsors) ---

enum CashTransactionType {
  IN
  OUT
}

enum SalaryStatus {
  PAID
  PENDING
}

enum KhataEntryType {
  DEBIT
  CREDIT
}

enum SupplyCategory {
  VEGETABLES
  WOOD
  CONSTRUCTION
}

model CashTransaction {
  id          String              @id @default(uuid())
  type        CashTransactionType
  amount      Decimal             @db.Decimal(12, 2)
  date        DateTime            @db.Date
  category    String
  description String
  reference   String?
  createdAt   DateTime            @default(now())

  @@index([date])
  @@index([type])
}

model SalaryRecord {
  id           String       @id @default(uuid())
  employeeName String
  month        String
  amount       Decimal      @db.Decimal(12, 2)
  status       SalaryStatus @default(PENDING)
  paidDate     DateTime?    @db.Date
  notes        String?
  createdAt    DateTime     @default(now())

  @@index([month])
  @@index([status])
}

model KhataEntry {
  id            String         @id @default(uuid())
  partyName     String
  type          KhataEntryType
  amount        Decimal        @db.Decimal(12, 2)
  settledAmount Decimal        @default(0) @db.Decimal(12, 2)
  date          DateTime       @db.Date
  description   String
  createdAt     DateTime       @default(now())

  @@index([date])
  @@index([partyName])
}

model SupplyExpense {
  id            String         @id @default(uuid())
  category      SupplyCategory
  amount        Decimal        @db.Decimal(12, 2)
  date          DateTime       @db.Date
  description   String
  vendor        String?
  payDate       DateTime?      @db.Date
  payerName     String?
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  pendingAmount Decimal        @default(0) @db.Decimal(12, 2)
  quantity      Decimal        @default(1) @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())

  @@index([date])
  @@index([category])
  @@index([payDate])
}

model FinanceInventoryItem {
  id        String   @id @default(uuid())
  name      String
  quantity  Int      @default(0)
  unit      String   @default("pcs")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finance_inventory_items")
}

model FinanceSponsor {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  monthlyAmount Decimal  @db.Decimal(12, 2)
  studentCount  Int      @default(1)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("finance_sponsors")
}