generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DATA_ENTRY
  TEACHER
  VIEWER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  EARLY_LEFT
  PASSED_OUT
  TRANSFERRED
  GRADUATED
}

enum AdmissionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum InventoryTransactionType {
  STOCK_IN
  USAGE
  ADJUSTMENT
  DAMAGED
}

enum BoardApplicationStatus {
  APPLIED
  PASSED
  FAILED
}

enum BackupType {
  CSV
  DATABASE
}

enum DocumentType {
  STUDENT_PHOTO
  B_FORM
  CNIC
  BIRTH_CERTIFICATE
  PREVIOUS_CERTIFICATE
  OTHER
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  fullName     String
  passwordHash String
  role         UserRole @default(DATA_ENTRY)
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

model Department {
  id            String   @id @default(uuid())
  code          String   @unique
  nameEn        String
  nameUr        String
  descriptionEn String?
  descriptionUr String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  classes            Class[]
  enrollments        StudentEnrollment[]
  admissions         StudentAdmission[]
  teacherDepartments TeacherDepartment[]
  attendanceSessions AttendanceSession[]

  @@index([updatedAt])
  @@index([deletedAt])
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  classes     Class[]
  enrollments StudentEnrollment[]
  admissions  StudentAdmission[]

  @@index([updatedAt])
  @@index([deletedAt])
}

model Student {
  id String @id @default(uuid())

  registrationNumber String? @unique

  fullNameEn   String?
  fullNameUr   String?
  fatherNameEn String?
  fatherNameUr String?

  dateOfBirth DateTime?
  gender      Gender?

  nationality String?
  religion    String?

  bFormNumber String? @unique
  cnicNumber  String? @unique

  phonePrimary   String?
  phoneSecondary String?
  phoneEmergency String?
  email          String?

  permanentAddress String?
  currentAddress   String?
  city             String?
  district         String?

  photoUrl String?
  status   StudentStatus @default(ACTIVE)
  version  Int           @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  guardians         Guardian[]
  enrollments       StudentEnrollment[]
  admissions        StudentAdmission[]
  documents         StudentDocument[]
  attendanceRecords AttendanceRecord[]
  statusHistory     StudentStatusHistory[]
  hifzReports       HifzDailyReport[]
  prizes            StudentPrize[]
  sponsorships      Sponsorship[]
  boardApplications BoardApplication[]
  visits            Visit[]

  @@index([fullNameEn])
  @@index([fullNameUr])
  @@index([fatherNameEn])
  @@index([fatherNameUr])
  @@index([updatedAt])
  @@index([deletedAt])
}

model Guardian {
  id        String @id @default(uuid())
  studentId String

  nameEn         String?
  nameUr         String?
  relationshipEn String?
  relationshipUr String?

  phonePrimary   String?
  phoneSecondary String?
  cnic           String?
  occupation     String?
  address        String?

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model StudentAdmission {
  id        String @id @default(uuid())
  studentId String

  admissionNumber    String @unique
  registrationNumber String?
  admissionDate      DateTime

  academicYearId String
  departmentId   String
  classId        String?

  previousInstitution      String?
  previousClass            String?
  previousEducationDetails String?

  status    AdmissionStatus @default(ACTIVE)
  remarks   String?
  startDate DateTime @default(now())
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  department Department @relation(fields: [departmentId], references: [id])

  class Class? @relation(fields: [classId], references: [id])

  @@index([studentId, status])
  @@index([departmentId, classId])
}

model StudentDocument {
  id        String       @id @default(uuid())
  studentId String
  type      DocumentType
  fileName  String
  fileUrl   String
  mimeType  String?
  fileSize  Int?
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type])
}

model Class {
  id             String @id @default(uuid())
  departmentId   String
  academicYearId String

  nameEn    String
  nameUr    String?
  code      String?
  capacity  Int?
  classType String?
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  department Department @relation(fields: [departmentId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  enrollments        StudentEnrollment[]
  admissions         StudentAdmission[]
  attendanceSessions AttendanceSession[]
  timetableEntries   TimetableEntry[]
  lectures           ClassLecture[]

  @@unique([departmentId, academicYearId, nameEn])
  @@index([updatedAt])
  @@index([deletedAt])
}

model StudentEnrollment {
  id             String @id @default(uuid())
  studentId      String
  departmentId   String
  classId        String
  academicYearId String

  rollNumber     String?
  enrollmentDate DateTime @default(now())
  startDate      DateTime @default(now())
  endDate        DateTime?
  status         String   @default("ACTIVE")
  remarks        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  department Department @relation(fields: [departmentId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([studentId])
  @@index([departmentId, classId])
}

model StudentStatusHistory {
  id            String        @id @default(uuid())
  studentId     String
  status        StudentStatus
  effectiveDate DateTime      @default(now())
  reason        String?
  createdAt     DateTime      @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Teacher {
  id             String @id @default(uuid())
  employeeNumber String @unique
  firstName      String
  lastName       String?
  fatherName     String?
  cnic           String?
  phone          String?
  email          String?
  address        String?
  qualification  String?
  subject        String?
  joiningDate    DateTime?
  status         String @default("ACTIVE")
  version        Int    @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments      TeacherDepartment[]
  timetableEntries TimetableEntry[]
  visits           Visit[]

  @@index([updatedAt])
  @@index([deletedAt])
}

model TeacherDepartment {
  id           String @id @default(uuid())
  teacherId    String
  departmentId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, departmentId])
}

model Timetable {
  id             String @id @default(uuid())
  name           String
  departmentId   String?
  academicYearId String?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TimetableEntry[]
}

model TimetableEntry {
  id          String @id @default(uuid())
  timetableId String
  teacherId   String
  classId     String
  dayOfWeek   Int
  startTime   String
  endTime     String
  subjectName String?
  room        String?
  remarks     String?

  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  teacher Teacher @relation(fields: [teacherId], references: [id])

  class Class @relation(fields: [classId], references: [id])
}

model AttendanceSession {
  id           String   @id @default(uuid())
  departmentId String
  classId      String
  date         DateTime
  sessionType  String   @default("DAILY")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  department Department @relation(fields: [departmentId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  records AttendanceRecord[]

  @@unique([classId, date, sessionType])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([date])
}

model AttendanceRecord {
  id                  String           @id @default(uuid())
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus
  remarks             String?
  version             Int              @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id])

  @@unique([attendanceSessionId, studentId])
  @@index([updatedAt])
  @@index([deletedAt])
}

model HifzDailyReport {
  id                String @id @default(uuid())
  studentId         String
  date              DateTime
  sabaq             String?
  sabqi             String?
  manzil            String?
  performanceRating String?
  remarks           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
}

model Visit {
  id             String @id @default(uuid())
  studentId      String?
  teacherId      String?
  visitorName     String
  visitorRelation String?
  visitorCnic     String?
  visitorAddress  String?
  visitorPhone    String?
  visitDate      DateTime
  checkInTime    DateTime?
  checkOutTime   DateTime?
  reason         String?
  details        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student? @relation(fields: [studentId], references: [id])

  teacher Teacher? @relation(fields: [teacherId], references: [id])
}

model PrizeCategory {
  id            String @id @default(uuid())
  nameEn        String @unique
  nameUr        String?
  descriptionEn String?
  descriptionUr String?

  prizes StudentPrize[]
}

model StudentPrize {
  id                String @id @default(uuid())
  studentId         String
  categoryId        String
  awardDate         DateTime
  competitionName   String?
  prizeName         String?
  certificateNumber String?
  remarks           String?

  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  category PrizeCategory @relation(fields: [categoryId], references: [id])
}

model InventoryItem {
  id              String @id @default(uuid())
  nameEn          String @unique
  nameUr          String?
  unit            String
  minimumQuantity Float @default(0)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id              String @id @default(uuid())
  itemId          String
  type            InventoryTransactionType
  quantity        Float
  transactionDate DateTime @default(now())
  remarks         String?

  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Sponsor {
  id        String @id @default(uuid())
  name      String
  address   String?
  phone     String?
  reference String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sponsorships Sponsorship[]
}

model Sponsorship {
  id        String @id @default(uuid())
  sponsorId String
  studentId String
  amount    Decimal @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime?
  reference String?
  status    String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sponsor Sponsor @relation(fields: [sponsorId], references: [id])

  student Student @relation(fields: [studentId], references: [id])
}

model BoardApplication {
  id                String @id @default(uuid())
  studentId         String
  applicationNumber String @unique
  rollNumber        String?
  applicationDate   DateTime
  position          String?
  status            BoardApplicationStatus @default(APPLIED)

  sanadIssued       Boolean @default(false)
  sanadIssuedDate   DateTime?
  sanadCollected    Boolean @default(false)
  sanadCollectedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}

model AuditLog {
  id         String @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model SyncQueue {
  id         String @id @default(uuid())
  entityType String
  entityId   String
  operation  SyncOperation
  payload    Json?
  status     SyncStatus @default(PENDING)
  retryCount Int @default(0)
  lastError  String?

  createdAt DateTime @default(now())
  syncedAt   DateTime?

  @@index([status, createdAt])
}

model BackupLog {
  id       String @id @default(uuid())
  type     BackupType
  location String
  status   String
  error    String?

  createdAt DateTime @default(now())
}

// --- Finance module (cash, salaries, khata, supplies, inventory, sponsors) ---

enum CashTransactionType {
  IN
  OUT
}

enum SalaryStatus {
  PAID
  PENDING
}

enum KhataEntryType {
  DEBIT
  CREDIT
}

enum SupplyCategory {
  VEGETABLES
  WOOD
  CONSTRUCTION
}

model CashTransaction {
  id            String              @id @default(uuid())
  type          CashTransactionType
  amount        Decimal             @db.Decimal(12, 2)
  date          DateTime            @db.Date
  category      String
  description   String
  reference     String?
  receiptNumber String?
  donorName     String?
  donorAddress  String?
  billNumber    String?
  paidBy        String?
  version       Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([date])
  @@index([type])
  @@index([updatedAt])
  @@index([deletedAt])
}

model SalaryRecord {
  id           String       @id @default(uuid())
  employeeName String
  month        String
  amount       Decimal      @db.Decimal(12, 2)
  status       SalaryStatus @default(PENDING)
  paidDate     DateTime?    @db.Date
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([month])
  @@index([status])
  @@index([updatedAt])
}

model KhataEntry {
  id            String         @id @default(uuid())
  partyName     String
  type          KhataEntryType
  amount        Decimal        @db.Decimal(12, 2)
  settledAmount Decimal        @default(0) @db.Decimal(12, 2)
  date          DateTime       @db.Date
  description   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([date])
  @@index([partyName])
  @@index([updatedAt])
}

model SupplyExpense {
  id            String         @id @default(uuid())
  category      SupplyCategory
  amount        Decimal        @db.Decimal(12, 2)
  date          DateTime       @db.Date
  description   String
  vendor        String?
  payDate       DateTime?      @db.Date
  payerName     String?
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  pendingAmount Decimal        @default(0) @db.Decimal(12, 2)
  quantity      Decimal        @default(1) @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([date])
  @@index([category])
  @@index([payDate])
  @@index([updatedAt])
}

model FinanceInventoryItem {
  id        String   @id @default(uuid())
  name      String
  quantity  Int      @default(0)
  unit      String   @default("pcs")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usages    FinanceInventoryUsage[]

  @@map("finance_inventory_items")
}

model FinanceInventoryUsage {
  id        String               @id @default(uuid())
  itemId    String
  quantity  Int
  date      DateTime             @db.Date
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  item      FinanceInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([itemId])
  @@index([updatedAt])
  @@map("finance_inventory_usages")
}

model FinanceSponsor {
  id             String    @id @default(uuid())
  name           String
  phone          String?
  address        String?
  monthlyAmount  Decimal   @db.Decimal(12, 2)
  currency       String    @default("PKR")
  studentCount   Int       @default(1)
  studentIds     Json      @default("[]")
  durationMonths Int       @default(12)
  startsOn       DateTime? @db.Date
  reference      String?
  notes          String?
  studentProfiles Json     @default("{}")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([updatedAt])
  @@map("finance_sponsors")
}

model HifzProgressSheet {
  id          String   @id @default(uuid())
  classId     String
  className   String
  studentId   String
  studentName String
  fatherName  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rows HifzProgressRow[]

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([updatedAt])
}

model HifzProgressRow {
  id            String    @id @default(uuid())
  sheetId       String
  date          DateTime? @db.Date
  dayLabel      String    @default("")
  sabaqPara     String    @default("")
  sabaqLines    String    @default("")
  sabaqPukhtagi String    @default("")
  sabqiPara     String    @default("")
  ghalti        String    @default("")
  atkan         String    @default("")
  sabqiPukhtagi String    @default("")
  sami          String    @default("")
  sortOrder     Int       @default(0)

  sheet HifzProgressSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
}

/// Annual Hifz report card with three quarterly exam terms (matches printed form).
model HifzAnnualResult {
  id               String   @id @default(uuid())
  classId          String
  className        String
  studentId        String
  studentName      String
  fatherName       String   @default("")
  residence        String   @default("")
  district         String   @default("")
  academicYear     String
  departmentLabel  String   @default("شعبہ حفظ")
  /// Three term objects: lesson progress, attendance, marks, remarks
  terms            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([classId, studentId, academicYear])
  @@index([studentId])
  @@index([academicYear])
  @@index([updatedAt])
}

model ExamResult {
  id                 String   @id @default(uuid())
  classId            String
  className          String
  studentId          String
  studentName        String
  fatherName         String   @default("")
  registrationNumber String?
  examName           String
  subject            String
  marksObtained      Float
  marksMax           Float
  grade              String
  examDate           DateTime @db.Date
  remarks            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([classId])
  @@index([studentId])
  @@index([examName])
  @@index([examDate])
  @@index([updatedAt])
}

model PrizeAward {
  id                 String   @id @default(uuid())
  studentId          String?
  registrationNumber String?
  studentName        String
  fatherName         String   @default("")
  certificateNo      String
  departmentId       String
  departmentName     String
  prizeWon           String
  prizeType          String
  prizeTypeOther     String?
  awardedDate        DateTime @db.Date
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([departmentId])
  @@index([awardedDate])
  @@index([updatedAt])
}

model BoardExam {
  id                   String   @id @default(uuid())
  studentId            String?
  studentName          String
  fatherName           String   @default("")
  registrationNumber   String?
  className            String?
  department           String
  board                String
  academicYear         String
  examSession          String?
  result               String   @default("PENDING")
  position             String?
  certificateReceived  Boolean  @default(false)
  degreeReceived       Boolean  @default(false)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([department])
  @@index([board])
  @@index([result])
  @@index([academicYear])
  @@index([updatedAt])
}

model BoardRegistration {
  id                 String   @id @default(uuid())
  studentId          String?
  studentName        String
  fatherName         String   @default("")
  registrationNumber String?
  className          String?
  department         String
  board              String   @default("WIFAQ")
  academicYear       String
  studyYear          Int
  status             String   @default("PENDING")
  registrationDate   DateTime @db.Date
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([department])
  @@index([status])
  @@index([academicYear])
  @@index([registrationDate])
  @@index([updatedAt])
}

model ClassLecture {
  id          String   @id @default(uuid())
  classId     String
  subjectName String
  teacherId   String?
  teacherName String?
  dayOfWeek   Int?
  startTime   String?
  endTime     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([updatedAt])
}

model InstitutionSettings {
  id                   String   @id @default("default")
  nameUr               String   @default("")
  nameEn               String   @default("")
  addressUr            String   @default("")
  addressEn            String   @default("")
  affiliationUr        String   @default("")
  affiliationEn        String   @default("")
  affiliationNumberUr  String   @default("")
  affiliationNumberEn  String   @default("")
  updatedAt            DateTime @updatedAt
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  userId       String
  method       String
  path         String
  responseJson Json?
  statusCode   Int      @default(200)
  createdAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

model ClientMutation {
  id               String   @id @default(uuid())
  clientMutationId String   @unique
  userId           String
  entityType       String
  entityId         String?
  operation        SyncOperation
  resultJson       Json?
  appliedAt        DateTime @default(now())

  @@index([userId, appliedAt])
  @@index([entityType, entityId])
}